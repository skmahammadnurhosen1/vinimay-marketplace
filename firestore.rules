rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'ADMIN' || request.auth.token.admin == true);
    }

    function isSeller() {
      return isAuthenticated() &&
        (request.auth.token.role == 'SELLER' || isAdmin());
    }

    function isManufacturer() {
      return isAuthenticated() &&
        (request.auth.token.role == 'MANUFACTURER' || isAdmin());
    }

    // Prevents non-admins from tampering with security-critical fields
    function doesNotChangePrivilegedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'accountStatus', 'kycStatus', 'commissionRate', 'permissions', 'reviewedBy', 'reviewedAt']);
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == 'CUSTOMER';
      allow update: if (isOwner(userId) && doesNotChangePrivilegedFields()) || isAdmin();
      allow delete: if isAdmin();

      // Nested Addresses Subcollection
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 2. Customer Profiles
    match /customers/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 3. Seller Profiles & KYC Documents
    match /sellers/{sellerId} {
      allow read: if true; // Public seller summary (business name, rating, address)
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && request.resource.data.kycStatus == 'DRAFT';
      allow update: if (isOwner(resource.data.userId) && doesNotChangePrivilegedFields()) || isAdmin();
      allow delete: if isAdmin();

      // Sensitive KYC verification documents
      match /documents/{docId} {
        allow read: if isOwner(resource.data.userId) || isAdmin();
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin();
      }
    }

    // 4. Categories & Brands (Public Reference Data)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Vehicle Hierarchy (Public Reference Data)
    match /vehicle_manufacturers/{manufacturerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /vehicle_models/{modelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Products Collection (Catalog)
    match /products/{productId} {
      allow read: if resource.data.status == 'APPROVED' || (isAuthenticated() && resource.data.sellerId == request.auth.uid) || isAdmin();
      allow create: if (isSeller() || isManufacturer()) && request.resource.data.status in ['DRAFT', 'PENDING_REVIEW'];
      allow update: if (isAuthenticated() && resource.data.sellerId == request.auth.uid && (request.resource.data.status != 'APPROVED' || resource.data.status == 'APPROVED')) || isAdmin();
      allow delete: if isAdmin();
    }

    // 7. Inventory Collection
    match /inventory/{productId} {
      allow read: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if isAdmin(); // Stock modifications strictly governed via secure backend APIs
    }

    // 8. Inventory Movements (Immutable Audit Ledger)
    match /inventory_movements/{movementId} {
      allow read: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.performedBy == request.auth.uid;
      allow update, delete: if false; // Immutable audit log
    }

    // 9. Customer Carts
    match /carts/{customerId} {
      allow read, write: if isAuthenticated() && request.auth.uid == customerId;
    }

    // 10. Parent Marketplace Orders
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 11. Seller Sub-Orders
    match /sub_orders/{subOrderId} {
      allow read: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow create, delete: if isAdmin();
    }

    // 12. Payments
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow write: if isAdmin(); // Handled authoritatively by backend
    }

    // 13. Shipments
    match /shipments/{shipmentId} {
      allow read: if true; // Public tracking or customer/seller
      allow write: if isAdmin();
    }

    // 14. Returns
    match /returns/{returnId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 15. Refunds
    match /refunds/{refundId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 16. Warranty Claims
    match /warranty_claims/{claimId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 17. Webhook Event Deduplication Logs
    match /webhook_events/{eventId} {
      allow read, write: if false;
    }
    match /shipping_webhook_events/{eventId} {
      allow read, write: if false;
    }

    // 18. Product Authenticity Verifications
    match /product_verifications/{verifId} {
      allow read: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 19. Reviews & Ratings
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'APPROVED' || (isAuthenticated() && resource.data.customerId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 20. B2B Accounts & Pricing
    match /b2b_accounts/{accountId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus', 'credit'])) || isAdmin();
      allow delete: if isAdmin();
    }

    match /b2b_pricing/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 21. Finance, Commissions, Settlements & GST Invoices
    match /commissions/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /settlements/{settlementId} {
      allow read: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 22. Manufacturer Profiles
    match /manufacturer_profiles/{mfgId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 23. Notifications & User Preferences
    match /notifications/{notifId} {
      allow read, update: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create, delete: if isAdmin();
    }

    match /notification_preferences/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 24. Customer & Merchant Support Tickets
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Default Fallback: Deny any unspecified access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


