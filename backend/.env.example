# ==============================================================================
# AutoPartsHub Backend API — Environment Configuration Schema
# ==============================================================================

# Server Network Settings
PORT=10000
NODE_ENV=development

# Allowed Origins for CORS (Comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://vinimay-p2p-marketplace.web.app

# Firebase Admin SDK Configuration
# For production on Render: provide FIREBASE_SERVICE_ACCOUNT_JSON as a single minified base64 or JSON string,
# OR supply the discrete project keys below:
FIREBASE_PROJECT_ID=vinimay-p2p-marketplace
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@vinimay-p2p-marketplace.iam.gserviceaccount.com
# Private key with literal escaped newlines (\n)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=vinimay-p2p-marketplace.appspot.com

# Optional Service Account JSON Path (for local development)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
